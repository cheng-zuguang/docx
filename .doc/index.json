{
  "schemaVersion": "1.0",
  "project": {
    "name": "docx",
    "type": [
      "unknown"
    ],
    "primaryLanguages": [],
    "summary": "docx 是一个 Go CLI 工具，用于为任意代码仓库创建并维护 AI 可读的项目上下文。它在 .doc/ 目录中管理两类信息：由 CLI 刷新的「生成事实」（项目结构、模块路径、最近变更）和需要人工显式确认的「语义记忆」（设计决策、反模式、模块摘要、风险规则）。AI Agent 从 .doc/index.json 出发，按需渐进式加载上下文，避免每次会话重复扫描整个仓库。工具链包含扫描器、分析器插件协议、git hook 集成、以及面向 Codex/Claude Code 的 agent lifecycle hook，支持在提交前自动记录变更并生成语义更新提案。"
  },
  "readOrder": [
    {
      "when": "always",
      "files": [
        ".doc/project.json",
        ".doc/rules/agent.md"
      ]
    },
    {
      "when": "editing module",
      "resolve": ".doc/modules/{module}.json"
    },
    {
      "when": "changing behavior",
      "files": [
        ".doc/decisions/index.json",
        ".doc/changes/index.json"
      ]
    },
    {
      "when": "debugging or reviewing",
      "files": [
        ".doc/mistakes/index.json"
      ]
    }
  ],
  "moduleMap": {
    "agent-proposals": {
      "paths": [
        "internal/cli/ai_update.go",
        "internal/cli/ai_init.go",
        "internal/cli/proposals.go"
      ],
      "context": ".doc/modules/agent-proposals.json",
      "confidence": "confirmed"
    },
    "agent-rules": {
      "paths": [
        "internal/cli/managed_blocks.go",
        "internal/cli/hooks.go"
      ],
      "context": ".doc/modules/agent-rules.json",
      "confidence": "confirmed"
    },
    "change-tracking": {
      "paths": [
        "internal/cli/update.go",
        "internal/cli/gitdiff.go"
      ],
      "context": ".doc/modules/change-tracking.json",
      "confidence": "confirmed"
    },
    "cli": {
      "paths": [
        "internal/cli/**"
      ],
      "context": ".doc/modules/cli.json",
      "confidence": "confirmed"
    },
    "docx": {
      "paths": [
        "cmd/docx/**"
      ],
      "context": ".doc/modules/docx.json",
      "confidence": "confirmed"
    }
  }
}
